{
  "core":{
    "log": {
        "leg_level": "debug",
        "log_file_max_size": 10000,
        "log_file_base_path":"/var/log/app/"
      },
      "monitor": {
        "host": "127.0.0.1",
        "port": 8080
      }
  },
  "plugins":{
      "mq":[],
      "http":
        [{
        "type":"default",
        "enable": 1,
        "ifname": "IAHTTPClient",
        "path": "plugins/http/",
        "name": "ahttpclient.so"
        }],
      "websocket":
        [{
        "type":"default",
        "enable": 1,
        "ifname": "IAWSClient",
        "path": "plugins/websocket/",
        "name": "awsclient.so"
        }],
      "mailer":
      [{
        "type":"default",
        "enable": 1,
        "ifname": "IAMailMessage",
        "path": "plugins/mailer/",
        "name": "amailer.so"
       }]
    }
  }